# Copy to .env.local for local dev. In production, set these as Cloud Run secrets.

# Required in production: signs session cookies (32+ random chars)
SESSION_SECRET=
# Optional: signs QR tokens (falls back to per-site seed secrets in demo)
QR_SIGNING_SECRET=
# Required in production unless DEMO_MODE=true: unlinks feedback from workers
FEEDBACK_HMAC_SECRET=
# Optional: signs public skill-passport links (defaults to SESSION_SECRET)
PASSPORT_SECRET=

# Gemini (Google AI Studio key). Without it the app uses deterministic fallbacks.
GEMINI_API_KEY=

# true = one-tap demo logins + keyless AI fixtures (default true in dev)
DEMO_MODE=true

# MongoDB Atlas connection string (production). Unset = in-memory demo data.
MONGODB_URI=
